// Zellij tab layout for a hive worker container
// {worker_id} and {container} are substituted at runtime
layout {
    tab name="{worker_id}" {
        pane split_direction="vertical" {
            pane name="Shell" size="60%" {
                command "hive"
                args "run" "{worker_id}" "bash" "-l"
            }
            pane split_direction="horizontal" {
                pane name="Logs" {
                    command "docker"
                    args "logs" "-f" "{container}"
                }
                pane name="Stats" size="20%" {
                    command "bash"
                    args "-c" "watch -n2 docker stats --no-stream --format 'table {{`{{.Name}}`}}\t{{`{{.CPUPerc}}`}}\t{{`{{.MemUsage}}`}}' {container}"
                }
            }
        }
    }
}
