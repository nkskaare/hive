// Zellij tab layout for a hive agent container
// {container} is substituted with the container name
layout {
    tab name="{container}" {
        pane split_direction="vertical" {
            pane name="Shell" size="60%" {
                command "docker"
                args "exec" "-it" "{container}" "bash" "-l"
            }
            pane split_direction="horizontal" {
                pane name="Logs" {
                    command "docker"
                    args "logs" "-f" "{container}"
                }
                pane name="Stats" size="20%" {
                    command "bash"
                    args "-c" "watch -n2 docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}' {container}"
                }
            }
        }
    }
}
